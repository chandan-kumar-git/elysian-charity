# TestSprite API Configuration
# Copy this file to .env and add your actual API key
TESTSPRITE_API_KEY=your-testsprite-api-key-here

# Instructions:
# 1. Copy: cp .env.example .env (Linux/Mac) or copy .env.example .env (Windows)
# 2. Edit .env and replace with your actual API key
# 3. Never commit .env to git (it's in .gitignore)

# For Windows users, alternatively use:
# setx TESTSPRITE_API_KEY "your-actual-api-key-here"