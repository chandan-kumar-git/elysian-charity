{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Start TestSprite MCP Server",
			"type": "shell",
			"command": "npx",
			"args": [
				"@testsprite/testsprite-mcp@latest",
				"server"
			],
			"isBackground": true,
			"problemMatcher": [],
			"runOptions": {
				"runOn": "folderOpen"
			},
			"presentation": {
				"reveal": "silent",
				"panel": "dedicated"
			},
			"options": {
				"env": {
					"API_KEY": "${env:TESTSPRITE_API_KEY}"
				}
			}
		},
		{
			"label": "Auto-Watch and Debug",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev"
			],
			"isBackground": true,
			"problemMatcher": {
				"owner": "node",
				"pattern": {
					"regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
					"file": 1,
					"line": 2,
					"column": 3,
					"severity": 4,
					"message": 5
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "^.*compilation.*started.*$",
					"endsPattern": "^.*compilation.*complete.*$"
				}
			},
			"runOptions": {
				"runOn": "folderOpen"
			},
			"presentation": {
				"reveal": "silent",
				"panel": "dedicated"
			}
		},
		{
			"label": "Auto-Test with TestSprite",
			"type": "shell",
			"command": "npm",
			"args": [
				"test",
				"--",
				"--watch"
			],
			"isBackground": true,
			"problemMatcher": {
				"owner": "jest",
				"pattern": {
					"regexp": "^\\s*✕\\s+(.*)\\s+\\((\\d+)\\s+ms\\)$",
					"message": 1
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "^.*Test Suites:.*$",
					"endsPattern": "^.*Tests:.*$"
				}
			},
			"group": "test",
			"runOptions": {
				"runOn": "folderOpen"
			},
			"presentation": {
				"reveal": "silent",
				"panel": "dedicated"
			}
		},
		{
			"label": "Auto-Lint and Fix",
			"type": "shell",
			"command": "npx",
			"args": [
				"eslint",
				".",
				"--fix",
				"--watch"
			],
			"isBackground": true,
			"problemMatcher": {
				"owner": "eslint",
				"pattern": {
					"regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)\\s+(.*)$",
					"file": 1,
					"line": 2,
					"column": 3,
					"severity": 4,
					"message": 5,
					"code": 6
				}
			},
			"runOptions": {
				"runOn": "folderOpen"
			},
			"presentation": {
				"reveal": "silent",
				"panel": "dedicated"
			}
		}
	]
}