{
  "autonomous": {
    "enabled": true,
    "autoFix": true,
    "autoTest": true,
    "autoDebug": true,
    "autoCommit": false,
    "permissions": {
      "readFiles": true,
      "writeFiles": true,
      "executeCommands": true,
      "installPackages": true,
      "modifyConfig": true,
      "runTests": true,
      "debugCode": true,
      "accessNetwork": true
    }
  },
  "testsprite": {
    "autoConnect": true,
    "autoDebug": true,
    "autoFix": true,
    "debugLevel": "verbose",
    "endpoints": {
      "server": "http://localhost:${PORT}",
      "api": "${env:TESTSPRITE_API_KEY}"
    }
  },
  "cline": {
    "autonomousMode": true,
    "autoAcceptTasks": true,
    "maxIterations": 10,
    "autoFixErrors": true,
    "debugOnError": true
  },
  "rooCode": {
    "autonomousMode": true,
    "teamMode": true,
    "autoAssignTasks": true,
    "autoReview": true
  },
  "debugging": {
    "autoAttach": true,
    "breakOnError": true,
    "autoRestart": true,
    "smartStepping": true,
    "logLevel": "debug"
  },
  "workflows": {
    "onError": [
      "analyze",
      "testsprite-debug",
      "auto-fix",
      "test",
      "retry"
    ],
    "onStart": [
      "install-deps",
      "lint",
      "test",
      "start-servers"
    ],
    "onSave": [
      "lint",
      "format",
      "test-related"
    ]
  }
}