# Environment Variables
# Copy this file to .env.local and fill in your values

# Contract Configuration
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_OWNER_ADDRESS=

# Network Configuration
NEXT_PUBLIC_NETWORK_NAME=sepolia
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY

# Etherscan Configuration (for transaction links)
NEXT_PUBLIC_ETHERSCAN_BASE_URL=https://sepolia.etherscan.io
NEXT_PUBLIC_ETHERSCAN_API_KEY=

# App Configuration
NEXT_PUBLIC_APP_NAME="Elysian Charity"
NEXT_PUBLIC_APP_DESCRIPTION="Transparent Charity Donation System"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Analytics (Optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_MIXPANEL_TOKEN=

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_DEBUG=true